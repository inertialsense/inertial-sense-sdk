#---------------------------------------------------------------------------
# Aliases for IS-specific documentation patterns
#
# Usage examples (in source comments, use @ prefix):
#
#   @is_data_id  DID_GPS1_POS    Links to the data ID reference.
#   @is_units    m/s             Documents the unit of a field/parameter.
#   @is_fw_ver   1.2.3           Minimum firmware version requirement.
#   @is_note     Some note text  Renders an "IS Note" callout box in HTML.
#---------------------------------------------------------------------------

ALIASES               += "is_data_id{1}=@par Data ID:\n<tt>\1</tt>"
ALIASES               += "is_units{1}=@par Units:\n\1"
ALIASES               += "is_fw_ver{1}=@par Minimum firmware version:\n\1"
ALIASES               += "is_note{1}=@note <b>IS Note:</b> \1"
