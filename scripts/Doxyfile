# Doxyfile for Inertial Sense SDK
#
# This file is the base Doxygen configuration.  The generate-doxygen.sh (or
# .bat) wrapper injects runtime overrides by piping this file together with
# additional KEY=VALUE lines into `doxygen -`, so any setting here can be
# overridden without editing this file.
#
# Tag style: @ (Javadoc-compatible, e.g. @brief, @param, @return)

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------

PROJECT_NAME           = "Inertial Sense SDK"

# Left blank intentionally — the build script injects PROJECT_NUMBER at
# run time via: echo "PROJECT_NUMBER=<version>" | doxygen -
